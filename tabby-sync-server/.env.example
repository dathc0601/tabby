# Copy to .env next to compose.yaml and fill in. .env is gitignored; never commit it.

# Keys the fake KDF salts answered for unknown emails. Keep it stable across restarts.
# Generate with: openssl rand -hex 32
SERVER_SECRET=

# Password of the compose Postgres user "tabby". Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# trace, debug, info, notice, warning, error, critical
LOG_LEVEL=info
