<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A terminal must spawn arbitrary programs in a PTY and open arbitrary sockets,
	     which the App Sandbox forbids. Hardened Runtime stays on (see project.yml). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
